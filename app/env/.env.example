VITE_APP_TITLE = '拍片哥女装'
VITE_APP_PORT = 9000

VITE_UNI_APPID = '__UNI__D1E5001'
VITE_WX_APPID = 'touristappid'

# 默认后台请求地址
VITE_SERVER_BASEURL = 'http://127.0.0.1:8000'
VITE_ASSET_BASE_URL = 'https://paipiange.github.io/nvzhuang'
VITE_USE_MOCK = false

# 微信开发者工具 CLI 路径（请按本机实际安装位置配置）
# WECHAT_DEVTOOLS_CLI_PATH = 'C:\Program Files (x86)\Tencent\微信web开发者工具\cli.bat'

# h5部署网站的base
VITE_APP_PUBLIC_BASE=/

# h5是否需要配置代理
VITE_APP_PROXY_ENABLE = false
VITE_APP_PROXY_PREFIX = '/fg-api'
VITE_APP_ROUTER_MODE = hash

VITE_SERVER_BASEURL_SECONDARY = 'http://127.0.0.1:8000'

# 认证模式，'single' | 'double' ==> 单token | 双token
VITE_AUTH_MODE = 'single'

# 原生插件资源复制开关
VITE_COPY_NATIVE_RES_ENABLE = true
