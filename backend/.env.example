# 后端环境变量配置示例
# 复制为 .env 文件后按需填写。操作系统/容器变量优先于本文件，本文件优先于 config.yaml。
# cp .env.example .env

# OpenAI GPT-Image-2 (官方生图模型)
OPENAI_API_KEY=

# 豆包 Seedream (火山方舟，国内免翻墙首选)
ARK_API_KEY=

# Google Gemini (Nano Banana 2)
GEMINI_API_KEY=

# 通义万相 / 阿里百炼
DASHSCOPE_API_KEY=

# 豆包 SeedDuplex 实时语音
SEEDUPLEX_API_KEY=
SEEDUPLEX_VOICE_ZHIXIA=zh_female_vv_jupiter_bigtts
SEEDUPLEX_VOICE_LINXI=

# 本地 CosyVoice 角色音色映射
VOICE_LOCAL_ZHIXIA=local-reference
VOICE_LOCAL_LINXI=

# 本地语音模型下载与 CosyVoice 授权参考音频
HF_TOKEN=
MODELSCOPE_API_TOKEN=
COSYVOICE_REFERENCE_WAV=
COSYVOICE_REFERENCE_TEXT=
COSYVOICE_LINXI_REFERENCE_WAV=
COSYVOICE_LINXI_REFERENCE_TEXT=

# 后端访问鉴权 Token（至少 32 个字符，多个以英文逗号分隔；当 security.authRequired: true 时必须配置）
TRYON_API_KEYS=

# config.yaml 中任意已存在的叶子配置都可以用 NVZHUANG_ 环境变量覆盖。
# 命名规则：配置路径转大写下划线，连字符和驼峰也转为下划线。
# 以下仅为示例，按需取消注释：
# NVZHUANG_SERVER_ADDRESS=:8000
# NVZHUANG_OBSERVABILITY_METRICS_ENABLED=true
# NVZHUANG_OBSERVABILITY_ALLOW_REMOTE_METRICS=false
# NVZHUANG_LLM_MODELS_GPT_IMAGE_BASE_URL=https://api.openai.com/v1
# NVZHUANG_LLM_MODELS_GPT_IMAGE_MODEL=gpt-image-2
# NVZHUANG_SECURITY_AUTH_REQUIRED=true
# NVZHUANG_SECURITY_TRUSTED_ORIGINS=https://example.com,http://127.0.0.1:5173
# NVZHUANG_SECURITY_RATE_LIMIT_REQUESTS_PER_MINUTE=10
# NVZHUANG_UPLOAD_MAX_REQUEST_BODY_BYTES=25165824
# NVZHUANG_VOICE_ROOT=./runtime/voice
# NVZHUANG_VOICE_FFMPEG=ffmpeg
